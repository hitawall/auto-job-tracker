# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # server-only, never expose to browser

# ── App ────────────────────────────────────────────────────────────────────────
# Full URL of the deployed app (no trailing slash). Used for OAuth redirects.
# In development this is http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ── Cron security ─────────────────────────────────────────────────────────────
# A random secret used to authenticate Vercel cron job calls.
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-secret-here

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Sign up at https://resend.com — free tier: 3k emails/month
# After adding your domain, update the FROM address below.
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM=Job Tracker <alerts@yourdomain.com>

# ── Notifications (added in Phase 5) ─────────────────────────────────────────
# Twilio — WhatsApp sandbox (https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # sandbox number

# Telegram bot (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=
